# Copy to .env locally and replace placeholders. Never commit the real .env.
DATABASE_PATH=E:\05_数据库与SQL\mental_health_assistant\data\mental_health.db
DATABASE_REQUIRED_DRIVE=E:
AUTH_PEPPER_FILE=D:\path\to\private\auth_pepper.key

DEEPSEEK_API_KEY=replace-with-your-server-side-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20

# Web security. Production must use HTTPS and SESSION_COOKIE_SECURE=true.
APP_ENV=development
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=65536
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=12
LOGIN_RATE_WINDOW_SECONDS=300
ASSISTANT_USER_LIMIT=20
ASSISTANT_RATE_WINDOW_SECONDS=60
AGENT_TASK_TIMEOUT_SECONDS=30
AGENT_TASK_WORKERS=4
